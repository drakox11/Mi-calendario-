
<h2 class="sr-only">Calendario interactivo de seguimiento para los meses 1 y 2 del plan de aprendizaje de IA</h2>

<style>
.cal-wrap { padding: 1rem 0; }
.month-title { font-size: 18px; font-weight: 500; color: var(--color-text-primary); margin: 0 0 16px; }
.month-block { margin-bottom: 2rem; }
.week-row { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
.day-card {
  background: var(--color-background-primary);
  border: 0.5px solid var(--color-border-tertiary);
  border-radius: var(--border-radius-md);
  padding: 10px;
  width: 88px;
  cursor: pointer;
  transition: border-color 0.15s;
  user-select: none;
}
.day-card:hover { border-color: var(--color-border-secondary); }
.day-card.done { background: var(--color-background-success); border-color: var(--color-border-success); }
.day-num { font-size: 13px; font-weight: 500; color: var(--color-text-secondary); margin-bottom: 8px; }
.day-card.done .day-num { color: var(--color-text-success); }
.tasks { display: flex; flex-direction: column; gap: 5px; }
.task-row { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--color-text-secondary); }
.task-row input[type=checkbox] { accent-color: #3FB950; width: 13px; height: 13px; cursor: pointer; flex-shrink: 0; }
.task-row label { cursor: pointer; line-height: 1.3; }
.task-row.checked label { color: var(--color-text-success); text-decoration: line-through; }
.progress-bar-wrap { background: var(--color-background-secondary); border-radius: 99px; height: 6px; margin-bottom: 6px; overflow: hidden; }
.progress-bar-fill { height: 100%; border-radius: 99px; background: #3FB950; transition: width 0.3s; }
.progress-label { font-size: 12px; color: var(--color-text-secondary); margin-bottom: 16px; }
.legend { display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
.legend-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--color-text-secondary); }
.legend-dot { width: 12px; height: 12px; border-radius: 3px; }
.reset-btn { font-size: 12px; color: var(--color-text-tertiary); background: none; border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-md); padding: 5px 12px; cursor: pointer; margin-top: 8px; }
.reset-btn:hover { color: var(--color-text-secondary); border-color: var(--color-border-secondary); }
.month-stats { font-size: 13px; color: var(--color-text-secondary); margin-bottom: 12px; }
</style>

<div class="cal-wrap">

<div class="legend">
  <div class="legend-item"><div class="legend-dot" style="background:var(--color-background-success);border:0.5px solid var(--color-border-success)"></div> Día completado</div>
  <div class="legend-item"><div class="legend-dot" style="background:var(--color-background-primary);border:0.5px solid var(--color-border-tertiary)"></div> Pendiente</div>
</div>

<div id="cal-root"></div>
<button class="reset-btn" onclick="resetAll()"><i class="ti ti-refresh" aria-hidden="true"></i> Reiniciar todo</button>
</div>

<script>
const TASKS_M1 = [
  { id:'py', label:'Python (Píldoras)' },
  { id:'pr', label:'Práctica código' },
  { id:'en', label:'Inglés (Duolingo)' },
  { id:'ma', label:'Matemáticas (Khan)' },
];
const TASKS_M2 = [
  { id:'py', label:'Python (Píldoras)' },
  { id:'pr', label:'Práctica código' },
  { id:'en', label:'Inglés (Duolingo)' },
  { id:'ma', label:'Matemáticas (Khan)' },
];

const MONTHS = [
  { label: 'Mes 1 — Python + Fundamentos', key: 'm1', days: 30, tasks: TASKS_M1 },
  { label: 'Mes 2 — Python avanzado + Inglés A1', key: 'm2', days: 30, tasks: TASKS_M2 },
];

function stateKey(mk, d, tk) { return `cal_${mk}_d${d}_${tk}`; }

function getState(mk, d, tk) {
  try { return localStorage.getItem(stateKey(mk,d,tk)) === '1'; } catch(e) { return false; }
}
function setState(mk, d, tk, val) {
  try { localStorage.setItem(stateKey(mk,d,tk), val ? '1' : '0'); } catch(e) {}
}

function isDayDone(mk, d, tasks) {
  return tasks.every(t => getState(mk, d, t.id));
}

function countDone(mk, days, tasks) {
  let n = 0;
  for(let d=1;d<=days;d++) if(isDayDone(mk,d,tasks)) n++;
  return n;
}

function render() {
  const root = document.getElementById('cal-root');
  root.innerHTML = '';

  MONTHS.forEach(month => {
    const done = countDone(month.key, month.days, month.tasks);
    const pct = Math.round((done / month.days) * 100);

    const mb = document.createElement('div');
    mb.className = 'month-block';

    mb.innerHTML = `
      <div class="month-title">${month.label}</div>
      <div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:${pct}%"></div></div>
      <div class="progress-label">${done} de ${month.days} días completados (${pct}%)</div>
    `;

    const weeksWrap = document.createElement('div');

    let weekRow = null;
    for(let d = 1; d <= month.days; d++) {
      if((d-1) % 7 === 0) {
        weekRow = document.createElement('div');
        weekRow.className = 'week-row';
        weeksWrap.appendChild(weekRow);
      }

      const allDone = isDayDone(month.key, d, month.tasks);
      const card = document.createElement('div');
      card.className = 'day-card' + (allDone ? ' done' : '');
      card.dataset.month = month.key;
      card.dataset.day = d;

      let tasksHtml = month.tasks.map(t => {
        const checked = getState(month.key, d, t.id);
        return `<div class="task-row${checked?' checked':''}">
          <input type="checkbox" id="cb_${month.key}_${d}_${t.id}" ${checked?'checked':''} data-mk="${month.key}" data-day="${d}" data-tk="${t.id}">
          <label for="cb_${month.key}_${d}_${t.id}">${t.label}</label>
        </div>`;
      }).join('');

      card.innerHTML = `<div class="day-num">Día ${d}</div><div class="tasks">${tasksHtml}</div>`;
      weekRow.appendChild(card);
    }

    mb.appendChild(weeksWrap);
    root.appendChild(mb);
  });

  document.querySelectorAll('input[type=checkbox]').forEach(cb => {
    cb.addEventListener('change', function() {
      const mk = this.dataset.mk, d = this.dataset.day, tk = this.dataset.tk;
      setState(mk, d, tk, this.checked);
      render();
    });
    cb.addEventListener('click', e => e.stopPropagation());
  });
}

function resetAll() {
  if(!confirm('¿Reiniciar todo el progreso?')) return;
  try {
    const keys = Object.keys(localStorage).filter(k => k.startsWith('cal_'));
    keys.forEach(k => localStorage.removeItem(k));
  } catch(e) {}
  render();
}

render();
</script>
